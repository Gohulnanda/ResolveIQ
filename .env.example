# Copy to .env and edit. Every value is optional; the defaults run in demo mode.
# NEVER commit your real .env file.

LOG_LEVEL=INFO

# LLM provider: demo (default, no key, no network) | anthropic | openai (any OpenAI-compatible API)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=
# Optional override, e.g. a self-hosted OpenAI-compatible server
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

# Retrieval: auto (use neural embeddings if installed, else offline hybrid) | hybrid | sentence-transformers
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.35

CLASSIFIER_MIN_CONFIDENCE=0.30
MAX_REQUEST_BYTES=32768

# Used by the Streamlit UI
API_URL=http://localhost:8000
